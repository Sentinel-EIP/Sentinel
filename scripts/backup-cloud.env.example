# Sauvegardes du poste fixe — copier en ~/backup/backup-cloud.env, chmod 600.
# JAMAIS commite. Lu (source) par scripts/backup-cloud.sh : syntaxe shell,
# valeurs sans espace. Autre emplacement : BACKUP_CONFIG=<chemin>.

# Remote rclone de destination, ex. b2:<bucket>/poste-fixe
BACKUP_REMOTE=

# Cle PUBLIQUE age du destinataire, ex. age1...  (age-keygen -y cle.txt)
# La cle privee correspondante ne doit pas etre sur ce poste.
AGE_RECIPIENT=

# Chemin absolu du .env de la stack cloud, ex. /home/<user>/<depot>/infra/stacks/cloud/.env
CLOUD_ENV_FILE=

# Optionnel : dossier de travail (stage, journal). Defaut : ~/backup
# BACKUP_WORK=

# Remote rclone des buckets Garage, cle sentinel-backup (lecture seule), ex. garage:
# Vide : buckets non sauvegardes (signale). Voir docs/SAUVEGARDES.md.
S3_REMOTE=
