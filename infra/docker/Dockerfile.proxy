# Reverse proxy local : nginx NON-ROOT (uid 101), port 8080. Configuration figee
# dans l'image, qui est donc construite et scannee (Trivy) comme les autres.
# Version explicite, montee par Dependabot (.github/dependabot.yml). Branche
# mainline et non stable : la stable (1.30.x) n'avait pas d'image corrigee des
# CVE critiques de nginx 1.30.6 (Trivy, novembre 2026). nginx recommande
# mainline en production ; meme version pour frontend et proxy.
FROM nginxinc/nginx-unprivileged:1.31.7-alpine AS prod
# Correctifs de securite Alpine publies depuis la derniere image de base.
# Non reproductible par nature : la CI reconstruit cette etape sans cache.
USER root
RUN apk upgrade --no-cache
USER 101
COPY infra/nginx/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 8080
