# Frontend React/Vite.
#   base  : npm ci depuis package-lock.json (reproductible, echoue si desynchronise)
#   dev   : serveur Vite (hot-reload, bind mount en dev)
#   build : bundle statique ; VITE_API_URL est fige AU BUILD (variable Vite)
#   prod  : nginx NON-ROOT (uid 101), port 8080
FROM node:22-alpine AS base
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund && npm cache clean --force

FROM base AS dev
COPY frontend/ ./
EXPOSE 5173
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]

FROM base AS build
# Derriere le reverse proxy, l'API est servie sous /api (meme origine).
ARG VITE_API_URL=/api
ENV VITE_API_URL=${VITE_API_URL}
COPY frontend/ ./
RUN npm run build

# Version explicite, montee par Dependabot (.github/dependabot.yml). Branche
# mainline et non stable : la stable (1.30.x) n'avait pas d'image corrigee des
# CVE critiques de nginx 1.30.6 (Trivy, novembre 2026). nginx recommande
# mainline en production ; meme version pour frontend et proxy.
FROM nginxinc/nginx-unprivileged:1.31.7-alpine AS prod
# Correctifs de securite Alpine publies depuis la derniere image de base
# (ex. libexpat, HIGH) : sans eux, le scan Trivy de la CI echoue. Non
# reproductible par nature : la CI reconstruit cette etape sans cache.
USER root
RUN apk upgrade --no-cache
USER 101
COPY --from=build /app/dist /usr/share/nginx/html
COPY infra/nginx/spa.conf /etc/nginx/conf.d/default.conf
EXPOSE 8080
