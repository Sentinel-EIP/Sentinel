# Relais du VPS — copier en ~/docker/relays.env sur le VPS. JAMAIS commite.
# Commun a tous les relais : docker compose --env-file ~/docker/relays.env up -d
# Aucune valeur par defaut : une variable vide fait echouer le demarrage.

# Adresse de la gateway dans le tunnel WireGuard (cote poste fixe), ex. 10.0.0.2
GATEWAY_TUNNEL_ADDRESS=

# Reseau Docker du Traefik du VPS et nom de son resolveur de certificats
TRAEFIK_NETWORK=
TRAEFIK_CERTRESOLVER=

# Domaines publics, enregistrements A vers l'IP du VPS
# ex. cloud.example.org
NC_DOMAIN=
# ex. s3.example.org
MINIO_DOMAIN=
