# Copier en .env — JAMAIS commite.
# Generer chaque secret : openssl rand -hex 24
# Aucune valeur par defaut : une variable vide fait echouer `docker compose up`.

# --- Domaines (doivent pointer vers l'IP du VPS, en DNS only) ----------------
# ex. cloud.example.org
NC_DOMAIN=
# ex. s3.example.org
MINIO_DOMAIN=

# --- Nextcloud ---------------------------------------------------------------
# Compte administrateur cree au premier demarrage (eviter admin, root, prenom)
NC_ADMIN_USER=
NC_ADMIN_PASSWORD=
NC_DB_NAME=nextcloud
NC_DB_USER=nextcloud
NC_DB_PASSWORD=
NC_REDIS_PASSWORD=

# --- MinIO -------------------------------------------------------------------
# L'API S3 est publique via le relais : nom root non trivial,
# MINIO_ROOT_PASSWORD de 24 caracteres minimum.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# Console d'administration : publiee sur 127.0.0.1 uniquement, jamais relayee.
MINIO_CONSOLE_PORT=9001
