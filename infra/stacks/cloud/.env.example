# Copier en .env — JAMAIS commite. chmod 600.
# Generer chaque secret : openssl rand -hex 24 (GARAGE_RPC_SECRET : -hex 32)
# Aucune valeur par defaut : une variable vide fait echouer `docker compose up`.

# --- Domaines (doivent pointer vers l'IP du VPS, en DNS only) ----------------
# ex. cloud.example.org
NC_DOMAIN=
# ex. s3.example.org
S3_DOMAIN=

# --- Reseau partage avec la gateway ------------------------------------------
# Sous-reseau de sentinel-edge, fixe a sa creation :
#   docker network create --subnet "$EDGE_SUBNET" sentinel-edge
# Nextcloud ne fait confiance qu'a lui pour X-Forwarded-For.
EDGE_SUBNET=172.30.255.0/24

# --- Nextcloud ---------------------------------------------------------------
# Compte administrateur cree au premier demarrage (eviter admin, root, prenom)
NC_ADMIN_USER=
NC_ADMIN_PASSWORD=
NC_DB_NAME=nextcloud
NC_DB_USER=nextcloud
NC_DB_PASSWORD=
NC_REDIS_PASSWORD=

# --- Garage (S3) -------------------------------------------------------------
# Secret du RPC entre noeuds : 32 octets en hexadecimal (openssl rand -hex 32).
# Les cles d'acces S3 sont creees par ./garage-init.sh, pas ici.
GARAGE_RPC_SECRET=
# API S3 publiee sur 127.0.0.1 pour rclone (sauvegardes), jamais sur le reseau.
GARAGE_S3_PORT=3900
