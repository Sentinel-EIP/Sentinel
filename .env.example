# Copier en .env — JAMAIS commite (cf. .gitignore)
# Secrets : openssl rand -hex 32

# --- General -----------------------------------------------------------------
ENVIRONMENT=local            # local | shared-dev | staging | production
LOG_LEVEL=INFO
TZ=Europe/Paris

# --- Base de donnees (PostgreSQL 16 + TimescaleDB) ---------------------------
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sentinel
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis (cache + broker Celery) -------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# --- Backend -----------------------------------------------------------------
API_SECRET_KEY=              # openssl rand -hex 32
API_PORT=8000
API_CORS_ORIGINS=http://localhost:5173
ML_SERVICE_URL=http://ml:8100

# --- Service ML ---------------------------------------------------------------
ML_PORT=8100
ML_MODEL_CACHE=/models       # volume persistant, evite de retelecharger

# --- Frontend -----------------------------------------------------------------
VITE_API_URL=http://localhost:8000

# --- Donnees de marche ---------------------------------------------------------
# Laisser vide en local : les collecteurs tournent en mode fixtures.
BINANCE_API_KEY=
BINANCE_API_SECRET=
