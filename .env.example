# Copier en .env — JAMAIS commite (cf. .gitignore)
# Secrets : openssl rand -hex 32. Un secret vide fait echouer `docker compose`.
# Ne jamais ecrire de commentaire en fin de ligne apres une valeur vide :
# il deviendrait la valeur.

# --- General -----------------------------------------------------------------
ENVIRONMENT=local            # local | shared-dev | staging | production
LOG_LEVEL=INFO
TZ=Europe/Paris

# --- Base de donnees (PostgreSQL 16 + TimescaleDB) ---------------------------
# Superutilisateur : reste dans le conteneur db, jamais transmis aux services.
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=
POSTGRES_DB=sentinel
# Role applicatif non superutilisateur, utilise par api et worker
# (cree par infra/db/init/10-app-role.sh).
APP_DB_USER=sentinel_app
APP_DB_PASSWORD=
# Hote et port (db:5432) sont fixes par la compose.

# --- Redis (cache + broker Celery) -------------------------------------------
# Hote et port (redis:6379) sont fixes par la compose.
REDIS_PASSWORD=

# --- Backend -----------------------------------------------------------------
# Signe les jetons de connexion (JWT) : 32 caracteres minimum, sinon l'API
# refuse de demarrer.
API_SECRET_KEY=
ACCESS_TOKEN_MINUTES=60
# Inscription libre : a passer a false sur un environnement partage.
AUTH_ALLOW_REGISTRATION=true
API_CORS_ORIGINS=http://localhost:5173
# URL du service ML fixee par la compose : http://ml:8100

# --- Service ML ---------------------------------------------------------------
ML_MODEL_CACHE=/models       # volume persistant, evite de retelecharger

# --- Frontend -----------------------------------------------------------------
# Pas de variable : en dev, le front appelle http://localhost:8000 (defaut du
# code) ; l'image prod est construite avec VITE_API_URL=/api, l'API etant servie
# par le proxy (meme origine) : voir infra/docker/Dockerfile.frontend.

# --- Donnees de marche ---------------------------------------------------------
# Bougies collectees par le worker (API publique de Binance, sans cle), tous
# les quarts d'heure. Premier passage : MARKET_BACKFILL_DAYS jours d'historique.
MARKET_SYMBOLS=BTCEUR,ETHEUR
MARKET_TIMEFRAMES=1h,1d
MARKET_BACKFILL_DAYS=90
# Cles d'exchange : inutilisees (aucun ordre n'est passe). Laisser vide.
BINANCE_API_KEY=
BINANCE_API_SECRET=
